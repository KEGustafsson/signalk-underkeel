{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "departure-window-response.json",
  "title": "POST /departure-window response",
  "type": "object",
  "required": ["windows", "steps"],
  "properties": {
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "defs.json#/$defs/isoTime" },
          "to": { "$ref": "defs.json#/$defs/isoTime" }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["departure", "status"],
        "properties": {
          "departure": { "$ref": "defs.json#/$defs/isoTime" },
          "status": { "$ref": "defs.json#/$defs/legStatus" }
        }
      }
    },
    "checks": { "type": "integer", "minimum": 0 }
  }
}
