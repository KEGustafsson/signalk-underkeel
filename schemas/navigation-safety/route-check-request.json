{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-check-request.json",
  "title": "POST /route-check, /route-repair and /departure-window request",
  "type": "object",
  "anyOf": [{ "required": ["route"] }, { "required": ["routeRef"] }],
  "properties": {
    "route": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": {
          "type": "array",
          "items": { "$ref": "defs.json#/$defs/lonLat" },
          "minItems": 2
        }
      }
    },
    "routeRef": { "type": "string", "pattern": "^/resources/routes/[A-Za-z0-9._:-]{1,128}$" },
    "departure": { "$ref": "defs.json#/$defs/isoTime" },
    "speed": {
      "description": "m/s: one value, a per-leg array, or { default } / { legs }.",
      "anyOf": [
        { "$ref": "#/$defs/speed" },
        { "type": "array", "items": { "$ref": "#/$defs/speed" }, "minItems": 1 },
        {
          "type": "object",
          "anyOf": [{ "required": ["default"] }, { "required": ["legs"] }],
          "properties": {
            "default": { "$ref": "#/$defs/speed" },
            "legs": { "type": "array", "items": { "$ref": "#/$defs/speed" }, "minItems": 1 }
          }
        }
      ]
    },
    "xteLimit": { "description": "metres", "type": "number", "minimum": 0, "maximum": 2000 },
    "probability": { "type": "number", "minimum": 1e-6, "maximum": 0.5 },
    "vessel": {
      "type": "object",
      "properties": {
        "draft": { "description": "metres", "type": "number", "minimum": 0.01, "maximum": 30 }
      }
    },
    "horizon": { "description": "departure-window only, seconds", "type": "number", "minimum": 0 },
    "step": { "description": "departure-window only, seconds", "type": "number", "minimum": 300 }
  },
  "$defs": {
    "speed": { "description": "m/s", "type": "number", "minimum": 0.1, "maximum": 30 }
  }
}
