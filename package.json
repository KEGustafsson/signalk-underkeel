{
  "name": "signalk-underkeel",
  "version": "0.1.0",
  "description": "Under-keel clearance awareness for Signal K: look-ahead grounding risk, route checks and a living chart.",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-notifications",
    "signalk-category-chart-plotters"
  ],
  "signalk": {
    "displayName": "Under-Keel Awareness"
  },
  "signalk-plugin-enabled-by-default": false,
  "scripts": {
    "clean:lib": "node -e \"const fs=require('fs');if(fs.existsSync('lib'))fs.rmSync('lib',{recursive:true,force:true});\"",
    "build": "npm run clean:lib && tsc",
    "check:ts": "tsc --noEmit",
    "check:release-docs": "node scripts/check-release-truth.js",
    "verify": "npm run check:ts && npm run lint && npm test",
    "verify:ci-local": "npm run check:ts && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run check:release-docs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint . --ext .js,.ts --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md,yml}\"",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.33.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "Karl-Erik Gustafsson",
  "repository": "https://github.com/KEGustafsson/signalk-underkeel",
  "homepage": "https://github.com/KEGustafsson/signalk-underkeel#readme",
  "bugs": {
    "url": "https://github.com/KEGustafsson/signalk-underkeel/issues"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "maxWorkers": 1,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json",
          "diagnostics": false
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/",
      "/__tests__/benchmarks/",
      "/__tests__/helpers/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
